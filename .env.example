# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: Login com Google + sincronização da Google Agenda (OAuth 2.0 Web Client ID)
VITE_GOOGLE_CLIENT_ID=

# Opcional: Clima via Google Weather API (se vazio, usa Open-Meteo automaticamente sem chave)
VITE_GOOGLE_WEATHER_API_KEY=

# Opcional: Notificações Web Push no celular/navegador (chave pública VAPID)
VITE_VAPID_PUBLIC_KEY=
